# local development
APP_ENV=development
DATABASE_URL=sqlite:///./jeomechu.db
CORS_ORIGINS=http://localhost:5173

# PostgreSQL pool defaults (used only for non-SQLite databases)
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE_SECONDS=300

# Railway production example
# APP_ENV=production
# DATABASE_URL=${{Postgres.DATABASE_URL}}
# CORS_ORIGINS=*
# WEB_CONCURRENCY=1

APP_ENV=development
FRONTEND_ORIGIN=http://localhost:5173

# 로컬 샘플은 json, 운영 서버는 supabase
DATA_BACKEND=json

# 운영에서만 설정하세요. service role key는 프론트/GitHub에 절대 노출하지 않습니다.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=cafe-photos
PHOTO_UPLOAD_ENABLED=true
PHOTO_MAX_BYTES=10485760
PHOTO_MAX_SIDE_PX=1600
PHOTO_WEBP_QUALITY=85

# 실제 일몰 전후 날씨 사용
WEATHER_MODE=open_meteo

# 프로토타입/개발: 아래 무료 endpoint는 API 키 없이 동작합니다.
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_API_KEY=
WEATHER_TIMEOUT_SEC=5
WEATHER_CACHE_TTL_SEC=900

# 상용 출시 시 Open-Meteo commercial plan을 사용하는 경우 예시:
# OPEN_METEO_BASE_URL=https://customer-api.open-meteo.com/v1/forecast
# OPEN_METEO_API_KEY=your-commercial-api-key

# Kakao Developers > 앱 키 > REST API 키
KAKAO_REST_API_KEY=

# NAVER Cloud Platform > Application Services > NAVER API HUB
# Application에서 NAVER 검색 > 블로그, 지역 API를 선택한 뒤 발급받습니다.
NAVER_API_HUB_CLIENT_ID=
NAVER_API_HUB_CLIENT_SECRET=
NAVER_API_HUB_BASE_URL=https://naverapihub.apigw.ntruss.com

# cafe_db_ready.csv를 운영 Supabase에 publish 할 때만 사용합니다.
# Service role key는 GitHub에 커밋하지 마세요.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Optional tuning
REQUEST_TIMEOUT_SEC=10
NAVER_BLOG_DISPLAY=10

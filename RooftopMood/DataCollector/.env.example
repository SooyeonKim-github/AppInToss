# Kakao Developers > 앱 키 > REST API 키
# Kakao Local + Daum Blog Search가 같은 키를 사용합니다.
KAKAO_REST_API_KEY=

# cafe_db_ready.csv를 운영 Supabase에 publish 할 때만 사용합니다.
# Service role key는 GitHub에 커밋하지 마세요.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Optional tuning
REQUEST_TIMEOUT_SEC=10
KAKAO_BLOG_DISPLAY=10
KAKAO_BLOG_MAX_PAGES=1
